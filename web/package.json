{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "check": "pnpm run check:i18n && pnpm run test",
    "check:i18n": "i18next-cli extract --dry-run --ci",
    "test": "node --test",
    "dev": "vite",
    "build": "pnpm run check && tsc -b && vite build",
    "lint": "oxlint && pnpm run check",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi/openapi.yaml -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "i18next": "^27.1.5",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.5",
    "recharts": "3.11.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "i18next-cli": "^1.91.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.94.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
