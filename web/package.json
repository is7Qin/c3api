{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "check": "pnpm run check:i18n",
    "check:i18n": "i18next-cli extract --dry-run --ci",
    "dev": "vite",
    "build": "pnpm run check && tsc -b && vite build",
    "lint": "oxlint && pnpm run check",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../openapi/openapi.yaml -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.29.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "recharts": "3.10.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "i18next-cli": "^1.71.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
