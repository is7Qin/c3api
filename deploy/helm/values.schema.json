{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "c3api Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "jwtSecret": { "type": "string" },
        "adminToken": { "type": "string" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dsn": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "externalRedis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "addr": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "inline": { "type": "boolean" },
        "content": { "type": "string" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "env": { "type": "object" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "tmpVolume": { "type": "boolean" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    }
  }
}
