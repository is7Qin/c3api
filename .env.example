# github.com/is7qin/c3api 部署环境变量（compose 在根目录时自动加载同名 .env）
# 用法：cp .env.example .env 后按需填写（.env 不进 git）

# 可选：管理端静态 token（留空 = 不启用，/admin 仅接受 platform_admin JWT
# 登录；首个注册用户自动成为 admin——bootstrap 后无静态 token 也能进管理面）
ADMIN_TOKEN=

# 必填：PG 密码（生产必改，默认 c3api 仅限本地）
POSTGRES_PASSWORD=c3api

# 可选：对外端口（默认 18080）
PORT=18080

# 必填：JWT 密钥（缺失启动失败；openssl rand -hex 32 生成）
AUTH_JWT_SECRET=

# Redis 地址（compose 默认注入 redis:6379，下方变量可覆盖；本地裸跑 go run 时
# 需自行 export C3API_REDIS_ADDR=127.0.0.1:6379——Redis 为必需依赖，缺省启动失败）
# REDIS_ADDR=redis:6379

# 可选 GC 调优（默认关闭，留空 = Go 默认 GOGC=100 无软上限）：
# 高并发（50k 并发 A/B 实测）开启后：QPS +14.5%、每请求 CPU -27.7%、
# 首字节 -21%、p99 首字节 -36%；代价：堆常驻 ~13G、GC 频率 ~10s 一次
# （GOMEMLIMIT 触发）。GOMEMLIMIT 只认纯字节数（16GiB = 17179869184），
# 勿带 G/GiB 等单位（非数字串启动即 fatal）。
# GOGC=off
# GOMEMLIMIT=17179869184
